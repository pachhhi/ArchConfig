window.active.title.bg: Flat Solid
window.active.title.bg.color: #6baf35
window.active.title.bg.colorTo: #6baf35

window.active.label.bg: Parentrelative
window.active.label.text.color: #1A1018

window.active.handle.bg: Flat Solid
window.active.handle.bg.color: #6baf35
window.active.handle.bg.colorTo: #6baf35

window.active.grip.bg: Flat Solid
window.active.grip.bg.color: #6baf35
window.active.grip.bg.colorTo: #6baf35

window.active.button.unpressed.bg: Flat Solid
window.active.button.unpressed.bg.color: #6baf35
window.active.button.unpressed.bg.colorTo: #558a2a
window.active.button.unpressed.bg.border.color: #6baf35
window.active.button.unpressed.image.color: #02314D

window.active.button.pressed.bg: Flat Gradient Vertical Border
window.active.button.pressed.bg.color: #02314D
window.active.button.pressed.bg.colorTo: #2a1a20
window.active.button.pressed.bg.border.color: #6baf35
window.active.button.pressed.image.color: #FAF5F0

window.active.button.disabled.bg: Flat Gradient Vertical Border
window.active.button.disabled.bg.color: #1A1018
window.active.button.disabled.bg.colorTo: #2a1a20
window.active.button.disabled.bg.border.color: #6baf35
window.active.button.disabled.image.color: #02314D

window.active.button.toggled.bg: Flat Gradient Vertical Border
window.active.button.toggled.bg.color: #558a2a
window.active.button.toggled.bg.colorTo: #40701f
window.active.button.toggled.bg.border.color: #6baf35
window.active.button.toggled.image.color: #FAF5F0


