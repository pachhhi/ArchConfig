window.inactive.title.bg.colorTo: #02314D

window.inactive.label.bg: Parentrelative
window.inactive.label.text.color: #3f5a2e

window.inactive.handle.bg: Flat Solid
window.inactive.handle.bg.color: #02314D
window.inactive.handle.bg.colorTo: #02314D

window.inactive.grip.bg: Flat Solid
window.inactive.grip.bg.color: #02314D
window.inactive.grip.bg.colorTo: #02314D

window.inactive.button.unpressed.bg: Flat Solid
window.inactive.button.unpressed.bg.color: #02314D
window.inactive.button.unpressed.bg.colorTo: #02314D
window.inactive.button.unpressed.bg.border.color: #6baf35
window.inactive.button.unpressed.image.color: #1A1018

window.inactive.button.pressed.bg: Flat Solid
window.inactive.button.pressed.bg.color: #02314D
window.inactive.button.pressed.bg.colorTo: #02314D
window.inactive.button.pressed.bg.border.color: #6baf35
window.inactive.button.pressed.image.color: #1A1018

