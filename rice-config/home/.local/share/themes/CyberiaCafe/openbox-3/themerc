### Everything else
# border.width y window.handle.width en 0: sin bordes ni grip visibles.
# padding.width subido a 6 (antes 0/2) para engrosar la titlebar y que se
# parezca a la franja alta de la imagen de referencia. Openbox no tiene una
# clave "title height" directa: la altura sale de font size + padding.width*2.
# Si la querés todavía más alta, subí este valor (ej. 8 o 10) o el <size> del
# font "ActiveWindow"/"InactiveWindow" en tu rc.xml.
border.width: 0
padding.width: 14
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
border.color: #6baf35
menu.overlap: 0


### Fonts
window.active.label.text.font:shadow=y:shadowtint=70:shadowoffset=1
window.inactive.label.text.font:shadow=y:shadowtint=20:shadowoffset=1
menu.items.font:
menu.title.text.font:shadow=y:shadowtint=70
