# Name: Ranma-Half-Green
# Author: John McKnight <jmcknight@gmail.com>
# Note: Recolored variant with #6baf35 titlebar, no visible borders,
#       taller titlebar (via increased padding.width) to match reference image.
#       Based on Ranma-Half (Clearlooks-Olive port for Openbox).

# ─── Palette reference ────────────────────────────────────────────────────────
#   Main Green      #6baf35   (titlebar)
#   Dark Green      #558a2a   (gradiente / detalles)
#   Muted Green     #a9cf8a   (titlebar inactiva)
#   Near-black      #1A1018   (texto activo / contornos)
#   Soft White      #FAF5F0
# ──────────────────────────────────────────────────────────────────────────────


# Menu settings
menu.title.bg: Flat Solid
menu.title.bg.color: #6baf35
menu.title.bg.colorTo: #558a2a
menu.title.text.color: #FAF5F0
menu.title.text.justify: Left

menu.items.bg: Flat Solid
menu.items.bg.color: #F5E6D0
menu.items.text.color: #02314D
menu.items.disabled.text.color: #aaaaaa
menu.items.active.disabled.text.color: #969696

menu.items.active.bg: Flat Solid
menu.items.active.bg.color: #6baf35
menu.items.active.bg.colorTo: #558a2a
menu.items.active.bg.border.color: #6baf35
menu.items.active.text.color: #FAF5F0


