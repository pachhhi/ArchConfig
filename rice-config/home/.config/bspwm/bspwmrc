#!/bin/sh

xrandr --dpi 110 2>/dev/null || true
xset s off -dpms s noblank 2>/dev/null || true
xsetroot -solid '#0A0A0A' 2>/dev/null || true

primary=$(xrandr --query | awk '/ connected primary/{print $1; exit}')
if [ -z "$primary" ]; then
    primary=$(xrandr --query | awk '/ connected/{print $1; exit}')
fi
if [ -n "$primary" ]; then
    bspc monitor "$primary" -d term web steam code any lab media
fi

bspc config border_width 2
bspc config window_gap 22
bspc config focused_border_color '#6ad6ff'
bspc config normal_border_color '#5b4b8a'
bspc config active_border_color '#5b4b8a'
bspc config remove_disabled_monitors true

bspc rule -a Spectacle state=floating border=off
bspc rule -a Pavucontrol state=floating

pgrep -x sxhkd >/dev/null 2>&1 || sxhkd -c "$HOME/.config/sxhkd/sxhkdrc.bspwm" &
pgrep -x picom >/dev/null 2>&1 || picom &
pgrep -x dunst >/dev/null 2>&1 || dunst &
pgrep -x eww >/dev/null 2>&1 || eww daemon &
"$HOME/.config/polybar/launch.sh" &
feh --no-fehbg --bg-fill "$HOME/.local/share/archconfig/wallpapers/bg.png" &
